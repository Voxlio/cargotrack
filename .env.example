# ---------------------------------------------------------------------------
# CargoTracker environment configuration
#
# Local development: copy this file to `.env` and fill in the values.
#     cp .env.example .env      (Windows: copy .env.example .env)
#
# Vercel: Project → Settings → Environment Variables. Add the same keys there
# and set them for Production (and Preview if you want previews to work).
# Never commit the real .env — it is already listed in .gitignore.
# ---------------------------------------------------------------------------

# --- Staff login -----------------------------------------------------------
# These replace the old hardcoded admin / password check.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# Signs the session tokens issued at login. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If omitted, a key is derived from ADMIN_PASSWORD (works, but set this).
SESSION_SECRET=

# How long a staff session stays valid, in hours. Default 8.
SESSION_TTL_HOURS=8

# --- Production storage (required on Vercel) -------------------------------
# Vercel's filesystem is read-only apart from /tmp, so database.json cannot be
# written there. Create a free Upstash Redis database at https://upstash.com,
# open its "REST API" section, and paste both values here.
#
# Leave these blank for local development: the server falls back to
# database.json automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: prefix for all Redis keys, so one database can host several apps.
SHIPP_KEY_PREFIX=shipp:

# --- Requests --------------------------------------------------------------
# Comma-separated list of origins allowed to call the API from another domain.
# Leave blank when the frontend and API share a domain (the Vercel default).
ALLOWED_ORIGINS=

# Timezone used for generated timestamps. Vercel runs in UTC by default.
TZ=Africa/Lagos
